{
  "_comment": "MLU-DPGEN run example: magnetic bcc Fe + non-magnetic liquid Fe committee workflow. See doc/mlu/01-workflow.md for every key.",

  "type_map": ["Fe"],
  "mass_map": [55.845],
  "use_ele_temp": 1,
  "magnetic_sys_idx": [0],
  "magnetic_init_sys": ["init_data/bcc.300K.1bar"],

  "init_data_prefix": "./init_data",
  "init_data_sys": ["bcc.300K.1bar", "liq.3000K.1bar"],
  "sys_configs": [
    ["confs/bcc.POSCAR"],
    ["confs/liq.POSCAR"]
  ],
  "_sys_batch_size_comment": "auto batch sizes",
  "sys_batch_size": ["auto", "auto"],
  "init_batch_size": ["auto", "auto"],

  "numb_models": 4,
  "default_training_param": [
    {
      "model": {"type": "standard",
                 "descriptor": {"type": "se_e2_a", "rcut": 6.0, "rcut_smth": 1.0,
                                  "sel": [100], "neuron": [25, 50, 100]},
                 "fitting_net": {"type": "ener", "neuron": [240, 240, 240],
                                   "default_uparam": 3.5, "uparam_mode": "frame"}},
      "loss": {"type": "ener", "start_pref_e": 0.02, "start_pref_f": 1000},
      "learning_rate": {"type": "exp", "start_lr": 0.001, "stop_lr": 3.51e-8},
      "training": {"numb_steps": 400000, "seed": 1, "disp_file": "lcurve.out"}
    },
    {
      "model": {"type": "standard",
                 "descriptor": {"type": "se_e2_a", "rcut": 6.5, "rcut_smth": 1.0,
                                  "sel": [110], "neuron": [25, 50, 100]},
                 "fitting_net": {"type": "ener", "neuron": [240, 240, 240],
                                   "default_uparam": 3.5, "uparam_mode": "frame"}},
      "loss": {"type": "ener", "start_pref_e": 0.02, "start_pref_f": 1000},
      "learning_rate": {"type": "exp", "start_lr": 0.001, "stop_lr": 3.51e-8},
      "training": {"numb_steps": 400000, "seed": 1, "disp_file": "lcurve.out"}
    }
  ],
  "_committee_comment": "list length must equal numb_models; identical entries are fine (seeds are re-randomized per model). Here 2 templates shown for brevity with numb_models=4, duplicate to 4 in production.",

  "mlu_training_param": {
    "model": {"type": "standard",
               "descriptor": {"type": "se_e2_a", "rcut": 6.0, "rcut_smth": 1.0,
                                "sel": [100], "neuron": [25, 50, 100]},
               "fitting_net": {"type": "mlu", "numb_fparam": 1,
                                 "neuron": [120, 120, 120], "intensive": null,
                                 "task_dim": 1}},
    "loss": {"type": "mlu", "loss_func": "smooth_mae", "metric": ["mae"], "beta": 1.0},
    "learning_rate": {"type": "exp", "start_lr": 0.001, "stop_lr": 3.51e-8},
    "training": {"numb_steps": 200000, "seed": 1,
                  "training_data": {"systems": "filled_by_dpgen", "batch_size": "auto"}}
  },

  "model_devi_jobs": [
    {"sys_idx": [0, 1], "ensemble": "npt", "nsteps": 300, "temps": [300, 1000, 2000],
     "press": [1.0, 10000.0, 500000.0], "trj_freq": 10,
     "mlu_model": "auto"},
    {"sys_idx": [0, 1], "ensemble": "npt", "nsteps": 1000, "temps": [300, 1500, 3000],
     "press": [1.0, 50000.0, 1000000.0], "trj_freq": 10,
     "mlu_model": "auto"},
    {"sys_idx": [0], "ensemble": "npt-x", "nsteps": 1000, "temps": [300, 1000],
     "press": [100000.0], "trj_freq": 10, "mlu_model": "auto"}
  ],
  "model_devi_dt": 0.002,
  "model_devi_skip": 0,
  "model_devi_f_trust_lo": 0.05,
  "model_devi_f_trust_hi": 0.25,
  "_trust_comment": "trust levels are recorded only in the MLU workflow; selection is governed by mlu_select below",

  "mlu_select": {
    "method": "pca-kmeans",
    "convergence_tolerance": 1.0,
    "seed": 42,
    "min_select": 1,
    "hull_coverage": 0.95,
    "grid_coverage": 0.0,
    "kde_js": 0.4,
    "energy_wasserstein": 0.05,
    "force_wasserstein": 0.15,
    "virial_wasserstein": 0.10
  },

  "fp_task_max": 50,
  "fp_task_min": 1,
  "fp_style": "pwscf",
  "fp_pp_path": "./pp",
  "fp_pp_files": ["Fe.pbe-spn-kjpaw_psl.1.0.0.UPF"],
  "fp_params": {
    "ecutwfc": 80,
    "ecutrho": 400,
    "kspacing": 0.6,
    "conv_thr": 1.0e-5,
    "smearing": "fd",
    "sigma": 0.01
  },
  "fp_hubbard": {
    "element": "Fe",
    "manifold": "3d",
    "u_init": 1.0,
    "u_init_source": "auto",
    "uparam_mode": "frame",
    "nspin": 2,
    "nspin_nm": 1,
    "starting_mag": 2.2,
    "nq1": 1, "nq2": 1, "nq3": 1,
    "aparam_uniform_fallback": false,
    "u_tp": [
      {"T": 300, "P": 1.0, "U": 3.8081},
      {"T": 1000, "P": 1.0, "U": 3.6209},
      {"T": 300, "P": 50000.0, "U": 3.8120},
      {"T": 1000, "P": 50000.0, "U": 3.5078}
    ]
  }
}
